ureSK.BrownianSystem":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.OrderParameter":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.extend":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.gradient":"ComparatorChallenges.SKFullSupport"},"written":"IsDiffusion"},{"dependency_source":"source_text","doc":null,"end_line":79,"kind":"def","line":77,"module":"ComparatorChallenges.SKFullSupport","name":"OAI.ZeroTemperatureSK.squareMoment","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"squareMoment","signature_end_line":78,"used_by":["OAI.ZeroTemperatureSK.FullSupportConclusion"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.gradient"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.OrderParameter":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.gradient":"ComparatorChallenges.SKFullSupport"},"written":"squareMoment"},{"dependency_source":"source_text","doc":null,"end_line":88,"kind":"def","line":81,"module":"ComparatorChallenges.SKFullSupport","name":"OAI.ZeroTemperatureSK.FullSupportConclusion","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"FullSupportConclusion","signature_end_line":81,"used_by":["OAI.ZeroTemperatureSK.full_support"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.IsDiffusion","OAI.ZeroTemperatureSK.IsStieltjesMeasure","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.Time","OAI.ZeroTemperatureSK.curvature","OAI.ZeroTemperatureSK.squareMoment"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.IsDiffusion":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.IsStieltjesMeasure":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.OrderParameter":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.Time":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.curvature":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.squareMoment":"ComparatorChallenges.SKFullSupport"},"written":"FullSupportConclusion"},{"dependency_source":"source_text","doc":null,"end_line":92,"kind":"theorem","line":90,"module":"ComparatorChallenges.SKFullSupport","name":"OAI.ZeroTemperatureSK.full_support","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"full_support","signature_end_line":91,"used_by":[],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.FullSupportConclusion","OAI.ZeroTemperatureSK.IsMinimizer","OAI.ZeroTemperatureSK.OrderParameter"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.FullSupportConclusion":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.IsMinimizer":"ComparatorChallenges.SKFullSupport","OAI.ZeroTemperatureSK.OrderParameter":"ComparatorChallenges.SKFullSupport"},"written":"full_support"}],"imports":["Mathlib"],"module":"ComparatorChallenges.SKFullSupport","path":"ComparatorChallenges/SKFullSupport.lean","sha256":"d8694501338ef2719c0b22738ccc2aca29ddb94cfe82ce048b842f71279d4085","source":"import Mathlib\n\nnamespace OAI\n\nopen MeasureTheory ProbabilityTheory Set Filter\nopen scoped ENNReal NNReal Topology\n\nnoncomputable section\n\nnamespace ZeroTemperatureSK\n\nabbrev Time := Set.Ico (0 : ℝ) 1\n\ndef extend (γ : Time → ℝ) (t : ℝ) : ℝ :=\n  if ht : t ∈ Set.Ico (0 : ℝ) 1 then γ ⟨t, ht⟩ else 0\n\nstructure OrderParameter where\n  val : Time → ℝ\n  nonneg : ∀ t, 0 ≤ val t\n  monotone : Monotone val\n  right_continuous : ∀ t, ContinuousWithinAt val (Set.Ici t) t\n  integrable : Integrable (extend val)\n\nstructure BrownianSystem (Ω : Type*) [MeasurableSpace Ω] where\n  law : Measure Ω\n  isProbability : IsProbabilityMeasure law\n  B : ℝ≥0 → Ω → ℝ\n  measurable : ∀ t, Measurable (B t)\n  brownian : IsBrownianReal B law\n\nvariable {Ω : Type*} [MeasurableSpace Ω]\n\ndef incrementFiltration (W : BrownianSystem Ω) (t : ℝ≥0) :\n    Filtration ℝ≥0 ‹MeasurableSpace Ω› :=\n  Filtration.natural (fun s ω => W.B (t + s) ω - W.B t ω)\n    (fun s => ((W.measurable (t + s)).sub (W.measurable t)).stronglyMeasurable)\n\nstructure Control (W : BrownianSystem Ω) (t : ℝ≥0) where\n  val : ℝ≥0 → Ω → ℝ\n  progressive : IsProgressive (incrementFiltration W t) val\n  bound : ∀ s ω, |val s ω| ≤ 1\n\ndef controlPayoff (W : BrownianSystem Ω) (γ : OrderParameter) (t x : ℝ)\n    (α : Control W (Real.toNNReal t)) (ω : Ω) : ℝ :=\n  |x + W.B 1 ω - W.B (Real.toNNReal t) ω +\n      ∫ s in t..1, extend γ.val s * α.val (Real.toNNReal (s - t)) ω| -\n    (1 / 2 : ℝ) * ∫ s in t..1, extend γ.val s * (α.val (Real.toNNReal (s - t)) ω)^2\n\ndef value (W : BrownianSystem Ω) (γ : OrderParameter) (t x : ℝ) : ℝ :=\n  sSup (Set.range (fun α : Control W (Real.toNNReal t) =>\n    ∫ ω, controlPayoff W γ t x α ω ∂W.law))\n\ndef gradient (W : BrownianSystem Ω) (γ : OrderParameter) (t x : ℝ) : ℝ :=\n  deriv (value W γ t) x\n\ndef curvature (W : BrownianSystem Ω) (γ : OrderParameter) (t x : ℝ) : ℝ :=\n  deriv (gradient W γ t) x\n\ndef parisi (W : BrownianSystem Ω) (γ : OrderParameter) : ℝ :=\n  value W γ 0 0 - (1 / 2 : ℝ) * ∫ t in (0 : ℝ)..1, t * extend γ.val t\n\ndef IsMinimizer (W : BrownianSystem Ω) (γ : OrderParameter) : Prop :=\n  ∀ η : OrderParameter, parisi W γ ≤ parisi W η\n\ndef IsStieltjesMeasure (γ : OrderParameter) (μ : Measure Time) : Prop :=\n  ∀ t : Time, μ (Set.Iic t) = ENNReal.ofReal (γ.val t)\n\ndef IsDiffusion (W : BrownianSystem Ω) (γ : OrderParameter)\n    (X : ℝ≥0 → Ω → ℝ) : Prop :=\n  IsProgressive (Filtration.natural W.B (fun t => (W.measurable t).stronglyMeasurable)) X ∧\n  (∀ᵐ ω ∂W.law, ContinuousOn (fun t : ℝ => X (Real.toNNReal t) ω) (Set.Icc 0 1) ∧\n    X 0 ω = 0 ∧ ∀ t ∈ Set.Icc (0 : ℝ) 1,\n      X (Real.toNNReal t) ω = W.B (Real.toNNReal t) ω +\n        ∫ s in (0 : ℝ)..t, extend γ.val s *\n          gradient W γ s (X (Real.toNNReal s) ω))\n\ndef squareMoment (W : BrownianSystem Ω) (γ : OrderParameter)\n    (X : ℝ≥0 → Ω → ℝ) (t : ℝ) : ℝ :=\n  ∫ ω, (gradient W γ t (X (Real.toNNReal t) ω))^2 ∂W.law\n\ndef FullSupportConclusion (W : BrownianSystem Ω) (γ : OrderParameter) : Prop :=\n  (∃ μ : Measure Time, IsStieltjesMeasure γ μ) ∧\n  (∃ X : ℝ≥0 → Ω → ℝ, IsDiffusion W γ X) ∧\n  (∀ μ : Measure Time, IsStieltjesMeasure γ μ → μ.support = Set.univ) ∧\n  (∀ a b : Time, a < b → γ.val a < γ.val b) ∧\n  ∀ X : ℝ≥0 → Ω → ℝ, IsDiffusion W γ X → ∀ t : Time,\n    squareMoment W γ X t = (t : ℝ) ∧\n    (∫ ω, (curvature W γ t (X (Real.toNNReal t) ω))^2 ∂W.law) = 1\n\ntheorem full_support (W : BrownianSystem Ω) (γ : OrderParameter)\n    (hmin : IsMinimizer W γ) : FullSupportConclusion W γ := by\n  sorry\n\nend ZeroTemperatureSK\n\nend\n\nend OAI\n"}