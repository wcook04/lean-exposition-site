3&paper=expository&passage=density-and-approximation","span":{"end_byte":59337,"end_line":1408,"start_byte":58598,"start_line":1399},"stage":"expository"}],"lenses":{"consumers":"/api/v1/graph?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&view=arguments&node=scalar.smooth_positive_density&direction=consumers&assumptions=true","direct_passages":"/api/v1/papers/query?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&node=scalar.smooth_positive_density&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&node=scalar.smooth_positive_density&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&view=arguments&node=scalar.smooth_positive_density&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&ref=sha256%3A3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db%2Fnodes%2Fscalar.smooth_positive_density","record":{"assumption_ids":["scalar.paper_minimizer"],"boundary":"Additional moment-bootstrap and fixed-time flattening argument. Not part of FullSupportConclusion and not needed by the QAOA scalar construction; do not place it in that prerequisite closure. The numerical lower bound is an ordinary deduction in long §9.2, not an extra clause of the selected formal endpoint; it depends on the same minimizer and moment normalization.","citation_ids":["scalar-r2-26-cite-smooth-positive-density"],"evidence_ids":["ordinary_reconstruction_bounds_20261024"],"id":"scalar.smooth_positive_density","kind":"claim","label":"Further manuscript corollary: smooth positive density","locator":"order-parameter-regularity.tex:15–152; cor:smooth-measure","source_id":"scalar-r2-26-source-order-parameter-regularity","statement":"For an admissible minimizer, gamma(0)=0, gamma∈C∞([0,1)), gamma=E Phi_xxx²/(2 E Phi_xx³), and mu(dt)=gamma′(t)dt. For 0<t<1, 2 gamma′ E Phi_xx³≥gamma(t)² E Phi_xx⁴/1000>0. Only gamma′(0)≥0 is asserted at zero. Since E Phi_xx²=1 and Phi_xx>=0, moment Cauchy–Schwarz gives E Phi_xx³<=sqrt(E Phi_xx⁴)<=E Phi_xx⁴. Hence gamma′(t)>=gamma(t)²/2000 for 0<t<1, and mu((r,s])>=(s-r)gamma(r)²/2000 for 0<r<s<1.","status":"unverified"},"ref":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","relations":[{"derived":true,"family":"arguments","from":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","id":"field:59f02e6bfb60e1451a36679abac89bae33c9f63625dec75383b4947a8443826c","kind":"assumption_ids","owner_ref":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","semantic_class":"explicit_assumption_reference","source_field":"assumption_ids","to":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.paper_minimizer"},{"derived":false,"family":"arguments","from":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","id":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/edges/%5B%22scalar.smooth_positive_density%22%2C%22support.fixed_time_spatial_coercivity%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/edges/%5B%22scalar.smooth_positive_density%22%2C%22support.fixed_time_spatial_coercivity%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/support.fixed_time_spatial_coercivity"},{"derived":false,"family":"arguments","from":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","id":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4c