ty%22%2C%22supports%22%5D","source_field":"from"},{"family":"provenance","id":"field:8f9a585f93154a9b031af03cd2b89626dc9de2ab77670fbf8757d758a4483c87","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.fixed_time_spatial_coercivity_at_jumps%22%2C%22support.diffusion%22%2C%22supports%22%5D","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","kind":"from","semantic_class":"edge_endpoint_reference","derived":true,"owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.fixed_time_spatial_coercivity_at_jumps%22%2C%22support.diffusion%22%2C%22supports%22%5D","source_field":"from"},{"family":"provenance","id":"field:93325c1b0280bd3aba4a533b240ff1ec1ed012afa917711598232a3599a6d746","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/citations/authored_r8_support_fixed_time_spatial_coercivity_at_jumps","kind":"citation_ids","semantic_class":"provenance_field_reference","derived":true,"owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","source_field":"citation_ids"},{"family":"provenance","id":"field:a95d8e1a25cb6dc37cf97e77d4b7606cd02a484757ea19ff29b04caec6c89708","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.fixed_time_spatial_coercivity_at_jumps%22%2C%22support.positive_curvature%22%2C%22supports%22%5D","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","kind":"from","semantic_class":"edge_endpoint_reference","derived":true,"owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.fixed_time_spatial_coercivity_at_jumps%22%2C%22support.positive_curvature%22%2C%22supports%22%5D","source_field":"from"},{"family":"provenance","id":"field:d6c4d3d2cc97b5fdd5c73ab352cfaa8dd099b76b2dbd5d17a769bc22308445cf","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/evidence/ordinary_deductions_review_20261026","kind":"evidence_ids","semantic_class":"provenance_field_reference","derived":true,"owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.fixed_time_spatial_coercivity_at_jumps","source_field":"evidence_ids"}],"neighborhood_href":"/api/v1/neighborhood?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&ref=sha256%3A9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5%2Fnodes%2Fsupport.fixed_time_spatial_coercivity_at_jumps"}