s/%5B%22circuit.positive_value%22%2C%22circuit.positive_input%22%2C%22supports%22%5D","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/circuit.positive_value","kind":"from","semantic_class":"edge_endpoint_reference","derived":true,"owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22circuit.positive_value%22%2C%22circuit.positive_input%22%2C%22supports%22%5D","source_field":"from"}],"neighborhood_href":"/api/v1/neighborhood?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&ref=sha256%3A9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5%2Fnodes%2Fcircuit.positive_value"}