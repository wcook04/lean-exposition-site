sumptions=true","direct_passages":"/api/v1/papers/query?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&node=scalar.finite_maximum_unique_modulo_flip&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&node=scalar.finite_maximum_unique_modulo_flip&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&view=arguments&node=scalar.finite_maximum_unique_modulo_flip&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&ref=sha256%3A05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0%2Fnodes%2Fscalar.finite_maximum_unique_modulo_flip","record":{"assumption_ids":[],"boundary":"Elementary finite-model deduction. It distinguishes exact maximizers at fixed size from near-ground pairs and supplies no rate, algorithm, formal replay or independent acceptance.","citation_ids":["authored_r10_finite_maximizer_uniqueness"],"evidence_ids":["ordinary_r10_proof_route_review_20261026"],"id":"scalar.finite_maximum_unique_modulo_flip","kind":"claim","label":"Finite Gaussian maximizers are unique up to reversal","locator":"Long reasoning record #exact-finite-maximizers","source_id":"authored_long_comparisons_20261024","statement":"For every fixed positive integer n, the pure zero-field SK Hamiltonian with independent standard Gaussian pair couplings has almost surely exactly one maximizing pair {sigma,-sigma}. Configurations not related by global reversal differ in at least one pair product, so their energy difference is a nondegenerate Gaussian; a finite union excludes all such ties. This does not exclude nearly maximizing configurations at other overlaps in the large-n limit.","status":"unverified"},"ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","relations":[{"derived":true,"family":"provenance","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:08e6f0acd7bb88b3e1a9e5eee0bc4372244805f95b78a6ef18f62bc80169b7e0","kind":"source_id","owner_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"source_id","to":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/sources/authored_long_comparisons_20261024"},{"derived":true,"family":"provenance","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/evidence/ordinary_r10_proof_route_review_20261026","id":"field:094fbd83d48f09905e53a62a1089d87bddc92c8955b71d67660be20caf769fb0","kind":"subject_ids","owner_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/evidence/ordinary_r10_proof_route_review_20261026","semantic_class":"provenance_field_reference","source_field":"subject_ids","to":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip"},{"derived":true,"family":"provenance","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:38540bee0528a7aaf7752a94da6cf69512511ea0d3c5cf28f31759fef285aa6a","kind":"evidence_ids","owner_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"evidence_ids","to":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/evidence/ordinary_r10_proof_route_review_20261026"},{"derived":true,"family":"provenance","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field