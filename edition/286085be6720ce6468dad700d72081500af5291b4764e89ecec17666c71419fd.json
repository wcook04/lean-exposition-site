sumptions=true","direct_passages":"/api/v1/papers/query?manifest=4070c5207ff30ed1d5bf15d57c03035ee4c69363e55697fa8a2a1859ad2aa618&node=scalar.finite_maximum_unique_modulo_flip&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=4070c5207ff30ed1d5bf15d57c03035ee4c69363e55697fa8a2a1859ad2aa618&node=scalar.finite_maximum_unique_modulo_flip&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=4070c5207ff30ed1d5bf15d57c03035ee4c69363e55697fa8a2a1859ad2aa618&view=arguments&node=scalar.finite_maximum_unique_modulo_flip&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=4070c5207ff30ed1d5bf15d57c03035ee4c69363e55697fa8a2a1859ad2aa618&ref=sha256%3A47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd%2Fnodes%2Fscalar.finite_maximum_unique_modulo_flip","record":{"assumption_ids":[],"boundary":"Elementary finite-model deduction. It distinguishes exact maximizers at fixed size from near-ground pairs and supplies no rate, algorithm, formal replay or independent acceptance.","citation_ids":["authored_r10_finite_maximizer_uniqueness"],"evidence_ids":["ordinary_r10_proof_route_review_20261026"],"id":"scalar.finite_maximum_unique_modulo_flip","kind":"claim","label":"Finite Gaussian maximizers are unique up to reversal","locator":"Long reasoning record #exact-finite-maximizers","source_id":"authored_long_comparisons_20261024","statement":"For every fixed positive integer n, the pure zero-field SK Hamiltonian with independent standard Gaussian pair couplings has almost surely exactly one maximizing pair {sigma,-sigma}. Configurations not related by global reversal differ in at least one pair product, so their energy difference is a nondegenerate Gaussian; a finite union excludes all such ties. This does not exclude nearly maximizing configurations at other overlaps in the large-n limit.","status":"unverified"},"ref":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip","relations":[{"derived":true,"family":"provenance","from":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/evidence/ordinary_r10_proof_route_review_20261026","id":"field:2732f5bf84f2e5a6d9dbc024d3f9f477e22f58cc89e9eb7b495f3b9790f08dc0","kind":"subject_ids","owner_ref":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/evidence/ordinary_r10_proof_route_review_20261026","semantic_class":"provenance_field_reference","source_field":"subject_ids","to":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip"},{"derived":true,"family":"provenance","from":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:a83da05f42860af590fbc53eaf2e07e2c040fc95f7c10e6a24b08bdb4ad14803","kind":"citation_ids","owner_ref":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"citation_ids","to":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/citations/authored_r10_finite_maximizer_uniqueness"},{"derived":true,"family":"provenance","from":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:bb092db50de7daaaf870be4f3dcdc2028c73c17e33cd19a97cbf4f7ff94f1ca1","kind":"evidence_ids","owner_ref":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"evidence_ids","to":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/evidence/ordinary_r10_proof_route_review_20261026"},{"derived":true,"family":"provenance","from":"sha256:47eb5f9cd8936c095f37a279430757722203f6e0f60993eeefcb2953ffb994dd/nodes/scalar.finite_maximum_unique_modulo_fli