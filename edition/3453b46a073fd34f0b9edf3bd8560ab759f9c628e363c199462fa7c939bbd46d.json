itive","claim_refs":["sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density"],"content_span":{"end_byte":170547,"end_line":3769,"start_byte":168188,"start_line":3725},"evidence_class":"source_argument","query_href":"/api/v1/papers/query?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=long&passage=density-positive&representation=matches","reading_href":"/api/v1/papers/reading?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=long&passage=density-positive","ref":"sha256:2b095aacecc1f5d7007325207b199a16856277bccf9cd83f2e5f52f0d81b6ef8/papers/long.md/sha256:af309f3a8460be4f12868d9deae92e9f84ec7fddc91b81a77167a172951f75ea/papers/long.json/passages/density-positive","section_ref":"sha256:2b095aacecc1f5d7007325207b199a16856277bccf9cd83f2e5f52f0d81b6ef8/papers/long.md/sections/164158","section_title":"9. Density and finite-disorder consequences","stage":"long","treatments":[{"claim_id":"scalar.smooth_positive_density","claim_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density","kinds":["derivation","application"],"rationale":"Applies the shared fixed-time spatial estimate after smoothness and moment saturation. Its proof destination records the nonminimizing artificial plateaus and fixed-strip transfer."}]},{"anchor":"density-consequence","claim_refs":["sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density","sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/support.fixed_time_spatial_coercivity"],"content_span":{"end_byte":35696,"end_line":729,"start_byte":29125,"start_line":603},"evidence_class":"source_argument","query_href":"/api/v1/papers/query?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=short&passage=density-consequence&representation=matches","reading_href":"/api/v1/papers/reading?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=short&passage=density-consequence","ref":"sha256:0cab99e62e04475d45ef7ab47579feee2be323ae8b9c4108d1e26adbd1ba36a2/papers/short.md/sha256:70909c03af03ed97dc42b71d01507ad744339ac2af9a884a4b889c882ece1c4a/papers/short.json/passages/density-consequence","section_ref":"sha256:0cab99e62e04475d45ef7ab47579feee2be323ae8b9c4108d1e26adbd1ba36a2/papers/short.md/sections/29049","section_title":"4. Strict positivity of the density","stage":"short","treatments":[{"claim_id":"scalar.smooth_positive_density","claim_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density","kinds":["derivation"],"rationale":"Develops smoothness from the quotient of moments before differentiating, then transfers the quantitative spatial-moment inequality through local constant replacements at a fixed interior time. Compact-strip stability is a cited input; positivity is asserted only for 0<t<1, and the argument does not transfer third time derivatives or add formal acceptance."},{"claim_id":"support.fixed_time_spatial_coercivity","claim_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/support.fixed_time_spatial_coercivity","kinds":["derivation","explanation"],"rationale":"Derives the continuous-coefficient fixed-time inequality by admissible local constant replacement and common-strip convergence of spatial moments, then applies it after q=t. Minimality is unnecessary for the transfer itself."}]},{"anchor":"density-and-approximation","claim_refs":["sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density"],"content_span":{"end_byte":60404,"end_line":1427,"start_byte":59665,"start_line":1418},"evidence_class":"source_argument","query_href":"/api/v1/papers/query?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=expository&passage=density-and-approximation&representation=matches","reading_href":"/api/v1/papers/reading?manifest=d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989&paper=expository&passage=density-and-approximation","ref":"sha256:c17d1e4e497443c153dbfaed9967804be060f37981ee446a2f3daf79a50f2f7a/papers/expository.md/sha256:3c748f53bb2f3e44dcb0d6e814dfdec32f507d6f2c7aca36d581cbe758b05a36/papers/expository.json/passages/density-and-approximation","section_ref":"sha256:c17d1e4e497443c153dbfaed9967804be060f37981ee446a2f3daf79a50f2f7a/papers/expository.md/sections/59602","section_title":"Further reading","stage":"expository","treatments":[{"claim_id":"scalar.smooth_positive_density","claim_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/scalar.smooth_positive_density","kinds":["reference"],"rationale":"Reports the additional smooth positive-density conclusion and directs its derivation to the source corollary and long record. This further-reading passage does not supply the smoothness or fixed-time replacement proof."}]}],"query":{"byte_ranges":null,"limit":200,"offset":0,"passages":["density-consequence"],"section_refs":null,"stage":"short","target_stage":null},"reading_view_version":"0.1.0","semantic_certification":false,"snapshot":{"bundle_id":"qaoa-sk-public-intake","bundle_version":"0.1.0","graph_sha256":"05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0","manifest_sha256":"d826b3c0b6c6f35f589d1afa29d3242b77e2d2de8e4a7dea759ef7a436dc4989"},"source_passage_refs":["sha256:0cab99e62e04475d45ef7ab47579feee2be323ae8b9c4108d1e26adbd1ba36a2/papers/short.md/sha256:70909c03af03ed97dc42b71d01507ad744339ac2af9a884a4b889c882ece1c4a/papers/short.json/passages/density-consequence"],"total":8}