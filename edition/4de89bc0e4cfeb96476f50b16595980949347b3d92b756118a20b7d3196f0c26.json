om derivatives of the contact function, with a separate right-hand expansion at zero. The origin argument retains contact at zero when zero belongs to the support and the zero-field identity q(0)=0."}],"to":"sha256:4b34070c1152369eec9bef536de51f8929c68f3a851f291e962a0c51a3b31ebb/papers/short.md/sha256:ea31b80e439953d8656d577aab47040525bb65952084d130b81d62bb48155487/papers/short.json/passages/contact"},{"annotation_basis":"shared_claim_ids","derived":true,"from":"sha256:67d89307e8131e8c2ca1f21749dce062218534d1ac25d4c5860f2500e234e33f/papers/expository.md/sha256:5a8502f1fc3023a0d2ac11439d1b08a02740be4a450ed7bbcd58d0f988753c2e/papers/expository.json/passages/contact-and-gap","id":"shared-claims:7e7235b6adb5fe257cdaf77c961e2cc167d0f8edaebe0b20064496ad934f9915","kind":"shared_claim","selection_relation":"outgoing","shared_claim_refs":["sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/support.positive_curvature"],"source_field":"passages.claim_ids","source_ref":"sha256:5a8502f1fc3023a0d2ac11439d1b08a02740be4a450ed7bbcd58d0f988753c2e/papers/expository.json","source_treatments":[],"target_ref":"sha256:ea31b80e439953d8656d577aab47040525bb65952084d130b81d62bb48155487/papers/short.json","target_treatments":[],"to":"sha256:4b34070c1152369eec9bef536de51f8929c68f3a851f291e962a0c51a3b31ebb/papers/short.md/sha256:ea31b80e439953d8656d577aab47040525bb65952084d130b81d62bb48155487/papers/short.json/passages/curvature"},{"annotation_basis":"shared_claim_ids","derived":true,"from":"sha256:67d89307e8131e8c2ca1f21749dce062218534d1ac25d4c5860f2500e234e33f/papers/expository.md/sha256:5a8502f1fc3023a0d2ac11439d1b08a02740be4a450ed7bbcd58d0f988753c2e/papers/expository.json/passages/contact-and-gap","id":"shared-claims:1bc9e9f5be616440f6bdfb9e492f793cf36009682dc77a29a9246094671573a2","kind":"shared_claim","selection_relation":"outgoing","shared_claim_refs":["sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/support.no_bounded_gap","sha256: