en":"weight_measurable"},{"dependency_source":"source_text","doc":null,"end_line":37,"kind":"lemma","line":33,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.jet_initial","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"jet_initial","signature_end_line":34,"used_by":["OAI.SKValue.ForwardDensityData.evolve_slope_concavity","OAI.SKValue.ForwardDensityData.jet_space","OAI.SKValue.ForwardShape.evolve","OAI.SKValue.ForwardShape.evolve_coupled_interior"],"uses":["OAI.SKValue.ForwardDensityData.jet","OAI.SKValue.ForwardDensityData.potential","OAI.SKValue.ForwardDensityData.size","OAI.SKValue.ForwardDensityData.variance","OAI.SKValue.coleHopf","OAI.SKValue.forwardJet","OAI.SKValue.heatDen","OAI.SKValue.heatScale","OAI.SKValue.heatTime","OAI.SKValue.scaledHeatJet"],"written":"jet_initial"},{"dependency_source":"source_text","doc":null,"end_line":42,"kind":"lemma","line":39,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.jet_space","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"jet_space","signature_end_line":39,"used_by":["OAI.SKValue.BackwardShape.certificate_signs","OAI.SKValue.BackwardShape.integrated_certificate","OAI.SKValue.ForwardDensityData.jet_continuous"],"uses":["OAI.SKValue.ForwardDensityData.jet_initial","OAI.SKValue.ForwardDensityData.potential","OAI.SKValue.ForwardDensityData.size","OAI.SKValue.ForwardDensityData.variance","OAI.SKValue.forwardJet","OAI.SKValue.forwardJet_space"],"written":"jet_space"},{"dependency_source":"source_text","doc":null,"end_line":44,"kind":"lemma","line":43,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.jet_continuous","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"jet_continuous","signature_end_line":43,"used_by":[],"uses":["OAI.SKValue.ForwardDensityData.jet_space"],"written":"jet_continuous"},{"dependency_source":"source_text","doc":null,"end_line":57,"kind":"def","line":46,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.evolve","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":true,"private":false,"protected":false,"short":"evolve","signature_end_line":46,"used_by":["OAI.SKValue.ForwardDensityData.evolve_weight"],"uses":["OAI.SKValue.ForwardDensityData","OAI.SKValue.ForwardDensityData.potential","OAI.SKValue.ForwardDensityData.size","OAI.SKValue.ForwardDensityData.size_pos","OAI.SKValue.ForwardDensityData.variance","OAI.SKValue.ForwardDensityData.variance_pos","OAI.SKValue.coleHopf","OAI.SKValue.coleHopf_even","OAI.SKValue.heatScale","OAI.SKValue.heatScale_mem","OAI.SKValue.heatTime"],"written":"evolve"},{"dependency_source":"source_text","doc":null,"end_line":72,"kind":"lemma","line":59,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.evolve_weight","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"evolve_weight","signature_end_line":60,"used_by":["OAI.SKValue.ForwardDensityData.response_pairing"],"uses":["OAI.SKValue.ForwardDensityData.evolve","OAI.SKValue.ForwardDensityData.potential","OAI.SKValue.ForwardDensityData.size","OAI.SKValue.ForwardDensityData.variance_pos","OAI.SKValue.ForwardDensityData.weight","OAI.SKValue.coleHopf","OAI.SKValue.heat","OAI.SKValue.heatDen_of_nonneg","OAI.SKValue.heatScale","OAI.SKValue.heatTime","OAI.SKValue.heat_gaussianFactor","OAI.SKValue.lipschitz_exp_integral_pos"],"written":"evolve_weight"},{"dependency_source":"source_text","doc":null,"end_line":95,"kind":"lemma","line":74,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.evolve_jet","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"evolve_jet","signature_end_line":75,"used_by":["OAI.SKValue.ForwardDensityData.evolve_slope_concavity","OAI.SKValue.ForwardShape.evolve"],"uses":["OAI.SKValue.ForwardDensityData.potential","OAI.SKValue.ForwardDensityData.size","OAI.SKValue.ForwardDensityData.variance","OAI.SKValue.coleHopf","OAI.SKValue.forwardJet","OAI.SKValue.heatDen_of_nonneg","OAI.SKValue.heatScale","OAI.SKValue.heatTime","OAI.SKValue.scaledHeatJet"],"written":"evolve_jet"},{"dependency_source":"source_text","doc":null,"end_line":113,"kind":"lemma","line":97,"module":"OAI.Probability.SKValue.Equations.ForwardDensity","name":"OAI.SKValue.ForwardDensityData.evolve_slope_concavity","namespace":"OAI.SKValue.ForwardDensityData","noncomputable":false,"private":false,"protected":false,"short":"evolve_slope_concavity","signature_end_line":101,"used_by":["OAI.SKValue.ForwardShape.evolve"],"uses":["OAI.SKValue.ForwardBurgers.preserve_concavity","OAI.SKValue.ForwardBurgers.preserve_slope","OAI.SKValue.ForwardDensityData.evolve_jet","OAI.SKValue.ForwardDensityData.jet_initial","OAI.SKValue.ForwardDensityData.size_pos","OAI.SKValue.ForwardDensityData.variance","OAI.SKValue.ForwardDensityData.variance_pos","OAI.SKValue.SmoothTerminal.forwardBurgers"],"written":"evolve_slope_concavity"}],"imports":["Mathlib","OAI.Probability.SKValue.Evolution.HeatTransform","OAI.Probability.SKValue.Evolution.TerminalAlgebra","OAI.Probability.SKValue.Gaussian.GaussianFactor"],"module":"OAI.Probability.SKValue.Equations.ForwardDensity","path":"OAI/Probability/SKValue/Equations/ForwardDensity.lean","sha256":"e1c47df3b4d7d00a22058840f0117877273c4d04c44ef01cd2dc62dce1a2f9c7","source":"import Mathlib\nimport OAI.Probability.SKValue.Evolution.HeatTransform\nimport OAI.Probability.SKValue.Evolution.TerminalAlgebra\nimport OAI.Probability.SKValue.Gaussian.GaussianFactor\n\nnamespace OAI\n\nsection\n\nopen MeasureTheory ProbabilityTheory Set Filter\nopen scoped Topology ContDiff NNReal\nnamespace SKValue\nstructure ForwardDensityData where\n  variance : ℝ\n  variance_pos : 0<variance\n  size : ℝ\n  size_pos : 0<size\n  potential : ℝ → ℝ\n  smooth : SmoothTerminal potential\n  even : ∀ x,potential (-x)=potential x\n\nnamespace ForwardDensityData\nvariable (D : ForwardDensityData)\nnoncomputable def weight (x : ℝ) : ℝ :=\n  gaussianPDFReal 0 D.variance.toNNReal x*Real.exp (D.size*D.potential x)\nnoncomputable def jet (n : ℕ) (x : ℝ) : ℝ :=\n  (if n=0 then x/D.variance else if n=1 then 1/D.variance else 0)-\n    D.size*iteratedDeriv n (deriv D.potential) x\nlemma weight_pos (x : ℝ) : 0<D.weight x :=\n  mul_pos (gaussianPDFReal_pos _ _ _ (Real.toNNReal_pos.mpr D.variance_pos).ne') (Real.exp_pos _)\nlemma weight_measurable : Measurable D.weight :=\n  (measurable_gaussianPDFReal _ _).mul ((measurable_const.mul D.smooth.smooth.continuous.measurable).exp)\nlemma jet_initial (n : ℕ) (x : ℝ) :\n    D.jet n x=forwardJet D.variance D.size D.potential n 0 x := by\n  have he : coleHopf D.size 0 D.potential=D.potential := funext (coleHopf_zero _ _)\n  have hv : D.variance^2/D.variance=D.variance := by field_simp\n  simp [forwardJet,heatDen,heatScale,heatTime,D.variance_pos.ne',hv,scaledHeatJet,he,jet]\n\nlemma jet_space (n : ℕ) (x : ℝ) : HasDerivAt (D.jet n) (D.jet (n+1) x) x := by\n  have he (k : ℕ) : D.jet k=forwardJet D.variance D.size D.potential k 0 := funext (D.jet_initial k)\n  rw [he n,he (n+1)]\n  exact forwardJet_space D.smooth D.size_pos.le n 0 x\nlemma jet_continuous (n : ℕ) : Continuous (D.jet n) :=\n  continuous_iff_continuousAt.mpr (fun x ↦ (D.jet_space n x).continuousAt)\n\nnoncomputable def evolve (t : ℝ) (ht : 0≤t) : ForwardDensityData where\n  variance := D.variance+t\n  variance_pos := add_pos_of_pos_of_nonneg D.variance_pos ht\n  size := D.size\n  size_pos := D.size_pos\n  potential := fun x ↦ coleHopf D.size (heatTime D.variance t) D.potential (heatScale D.variance t*x)\n  smooth := (D.smooth.evolve D.size_pos.le _).comp_mul (by\n    rw [abs_of_nonneg (heatScale_mem D.variance_pos t).1]\n    exact (heatScale_mem D.variance_pos t).2)\n  even := by\n    intro x\n    rw [mul_neg,coleHopf_even D.even]\n\nlemma evolve_weight (t : ℝ) (ht : 0≤t) (x : ℝ) :\n    (D.evolve t ht).weight x=heat t D.weight x := by\n  have he (v y : ℝ) : Real.exp (D.size*coleHopf D.size v D.potential y)=\n      heat v (fun z ↦ Real.exp (D.size*D.potential z)) y := by\n    simp only [coleHopf,ite_eq_right D.size_pos.ne']\n    rw [mul_div_cancel₀ _ D.size_pos.ne']\n    exact Real.exp_log (lipschitz_exp_integral_pos D.smooth.lipschitz D.size_pos.le y (Real.sqrt v))\n  unfold weight\n  rw [heat_gaussianFactor D.variance_pos ht\n    (D.smooth.smooth.continuous.measurable.const_mul D.size).exp]\n  simp only [evolve,he,heatScale,heatTime,heatDen_of_nonneg _ ht]\n  congr 2\n  field_simp [(add_pos_of_pos_of_nonneg D.variance_pos ht).ne']\n  ring\n\nlemma evolve_jet (t : ℝ) (ht : 0≤t) (n : ℕ) (x : ℝ) :\n    (D.evolve t ht).jet n x=forwardJet D.variance D.size D.potential n t x := by\n  let f := coleHopf D.size (heatTime D.variance t) D.potential\n  let lam := heatScale D.variance t\n  have hf := D.smooth.evolve D.size_pos.le (heatTime D.variance t)\n  have hfd := hf.smooth.differentiable (ENat.natCast_lt_of_coe_top_le_withTop le_rfl 0).ne'\n  have hder : deriv (fun y ↦ f (lam*y))=fun y ↦ lam*deriv f (lam*y) := by\n    funext y\n    convert! ((hfd (lam*y)).hasDerivAt.comp y ((hasDerivAt_id y).const_mul lam)).deriv using 1\n    simp\n    ring\n  have hjet : iteratedDeriv n (deriv (fun y ↦ f (lam*y))) x=\n      lam^(n+1)*iteratedDeriv n (deriv f) (lam*x) := by\n    rw [hder,iteratedDeriv_const_mul_field]\n    rw [iteratedDeriv_comp_const_mul (hf.jets.smooth.of_le (ENat.natCast_le_of_coe_top_le_withTop le_rfl n))]\n    ring\n  change (if n=0 then x/(D.variance+t) else if n=1 then 1/(D.variance+t) else 0)-\n    D.size*iteratedDeriv n (deriv (fun y ↦ f (lam*y))) x=_\n  rw [hjet]\n  simp only [forwardJet,heatDen_of_nonneg _ ht,scaledHeatJet]\n  dsimp [f,lam]\n  ring\n\nlemma evolve_slope_concavity\n    (h1 : ∀ x,1/D.variance≤D.jet 1 x)\n    (h2 : ∀ x,0≤x → D.jet 2 x≤0) {t : ℝ} (ht : 0≤t) :\n    (∀ x,1/(D.variance+t)≤(D.evolve t ht).jet 1 x) ∧\n    (∀ x,0≤x → (D.evolve t ht).jet 2 x≤0) := by\n  let F := D.smooth.forwardBurgers D.even D.variance_pos D.size_pos t\n  have hi1 : ∀ x,1/D.variance≤F.jet 1 0 x := by\n    simpa only [F,SmoothTerminal.forwardBurgers,←D.jet_initial] using h1\n  have hi2 : ∀ x,0≤x → F.jet 2 0 x≤0 := by\n    simpa only [F,SmoothTerminal.forwardBurgers,←D.jet_initial] using h2\n  constructor\n  · intro x\n    rw [D.evolve_jet]\n    exact F.preserve_slope D.variance_pos ht hi1 ⟨ht,le_rfl⟩ x\n  · intro x hx\n    rw [D.evolve_jet]\n    exact F.preserve_concavity D.variance_pos ht hi1 hi2 ⟨ht,le_rfl⟩ hx\n\nend ForwardDensityData\nend SKValue\n\nend\n\nend OAI\n"}