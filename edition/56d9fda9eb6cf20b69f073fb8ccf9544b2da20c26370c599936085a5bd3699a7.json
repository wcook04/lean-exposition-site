itive","claim_refs":["sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density"],"content_span":{"end_byte":170066,"end_line":3681,"start_byte":167739,"start_line":3642},"evidence_class":"source_argument","query_href":"/api/v1/papers/query?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&paper=long&passage=density-positive&representation=matches","reading_href":"/api/v1/papers/reading?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&paper=long&passage=density-positive","ref":"sha256:a19893f62d1211681ed0cb9cbb8bb454214d97f231f6a6d091b6f198fca35a89/papers/long.md/sha256:6b1c59ab234bbf188aa4d4b6025767453ec328d381122b018700a897280799ad/papers/long.json/passages/density-positive","section_ref":"sha256:a19893f62d1211681ed0cb9cbb8bb454214d97f231f6a6d091b6f198fca35a89/papers/long.md/sections/163679","section_title":"9. Density and finite-disorder consequences","stage":"long","treatments":[{"claim_id":"scalar.smooth_positive_density","claim_ref":"sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","kinds":["derivation","application"],"rationale":"Applies the shared fixed-time spatial estimate after smoothness and moment saturation. Its proof destination records the nonminimizing artificial plateaus and fixed-strip transfer."}]},{"anchor":"density-consequence","claim_refs":["sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/scalar.smooth_positive_density","sha256:3592e6a1f4e5ac9cf05e86d1dac98fabd5ac5f25ba57c4ce6e79c2b2f110d0db/nodes/support.fixed_time_spatial_coercivity"],"content_span":{"end_byte":34605,"end_line":703,"start_byte":28150,"start_line":578},"evidence_class":"source_argument","query_href":"/api/v1/papers/query?manifest=7606ede1164df321a11fa37e03c1309bd8ec65a37d50c5dd220f3a65f910ab03&paper=short&passage=density-consequence&representation=matches","reading_href":"/api/v1/papers/r