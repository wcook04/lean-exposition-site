notation_basis":"shared_claim_ids","derived":true,"shared_claim_refs":["sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.no_bounded_gap","sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.positive_curvature"],"source_treatments":[],"target_treatments":[{"claim_id":"support.positive_curvature","kinds":["statement","application"],"rationale":"States the quantitative curvature estimate for any admissible positive plateau and applies it together with minimiser contact to exclude a bounded gap. The estimate is an imported input here; its nonminimiser scope does not supply contact.","claim_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.positive_curvature"},{"claim_id":"support.no_bounded_gap","kinds":["derivation"],"rationale":"Derives the bounded-gap contradiction by integrating the endpoint-chord bound for q prime. Contact and the imported curvature estimate have separate roles; the initial and terminal cases are treated separately in the same passage.","claim_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.no_bounded_gap"}],"source_ref":"sha256:082c1187f897999ee934fa70dbb519221ed1e0aebc169fac91b7211a4a599dc5/papers/expository.json","target_ref":"sha256:b3fb22a55f09aba18f53cd9bbac859142355ee389bba5aa7bf98d016dc611a43/papers/short.json","source_field":"passages.claim_ids","selection_relation":"outgoing"},{"id":"shared-claims:655e39cba67c1bdbfe1b3c49b9d3d99cb791cedba30552dbaabc1ad29960879c","from":"sha256:a27286323604d97b33cbece7bb75d3d3291f7d7ec1ed0bfe12af548d92ff72dc/papers/expository.md/sha256:082c1187f897999ee934fa70dbb519221ed1e0aebc169fac91b7211a4a599dc5/papers/expository.json/passages/contact-and-gap","to":"sha256:9e0f6d255eb0a116c513a0c11e94d28559f0a429ef365c3137bb4ff3b6a061d6/papers/long.md/sha256:7588abc48d1c21bb64c366849eaa851938d6acc6b17cf16f89ccf8b87ca26853/papers/long.json/passages/contact","kind":"shared_claim","annotation_basis":"shared_claim_ids","derived":true,"shared_claim_refs":["sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.contact","sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.contact_derivatives"],"source_treatments":[],"target_treatments":[{"claim_id":"support.contact","kinds":["derivation","explanation"],"rationale":"Derives nonnegative variation potential and contact by admissible mass addition, compact fractional removal and continuity; support contact does not assert contact at arbitrary off-support points.","claim_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.contact"},{"claim_id":"support.contact_derivatives","kinds":["derivation"],"rationale":"Derives interior contact slopes and treats the one-sided origin condition separately from an interior minimum.","claim_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/support.contact_derivatives"}],"source_ref":"sha256:082c1187f897999ee934fa70dbb519221ed1e0aebc169fac91b7211a4a599dc5/papers/expository.json","target_ref":"sha256:7588abc48d1c21bb64c366849eaa851938d6acc6b17cf16f89ccf8b87ca26853/papers/long.json","source_field":"passages.claim_ids","selection_relation":"outgoing"},{"id":"shared-claims:54bc2be99e6d5426ad8c82bf5b6c984adf7a008a17960b687e77604c9be9eab3","from":"sha256:a27286323604d97b33cbece7bb75d3d3291f7d7ec1ed0bfe12af548d92ff72dc/papers/expository.md/sha256:082c1187f897999ee934fa70dbb519221ed1e0aebc169fac91b7211a4a599dc5/papers/expository.json/passages/contact-and-gap","to":"sha256:9e0f6d255eb0a116c513a0c11e94d28559f0a429ef365c3137bb4ff3b6a061d6/papers/long.md/sha256:7588abc48d1c21bb64c366849eaa851938d6acc6b17cf16f89ccf8b87ca26853/papers/long.json/passages/dependencies","kind":"shared_claim","annotation_basis":"shared_claim_ids","derived":true,"shared_claim_refs":["sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f9