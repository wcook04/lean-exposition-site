sumptions=true","direct_passages":"/api/v1/papers/query?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&node=scalar.finite_maximum_unique_modulo_flip&relation=direct","prerequisite_uses":"/api/v1/papers/query?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&node=scalar.finite_maximum_unique_modulo_flip&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&view=arguments&node=scalar.finite_maximum_unique_modulo_flip&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&ref=sha256%3A9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5%2Fnodes%2Fscalar.finite_maximum_unique_modulo_flip","record":{"assumption_ids":[],"boundary":"Elementary finite-model deduction. It distinguishes exact maximizers at fixed size from near-ground pairs and supplies no rate, algorithm, formal replay or independent acceptance.","citation_ids":["authored_r10_finite_maximizer_uniqueness"],"evidence_ids":["ordinary_r10_proof_route_review_20261026"],"id":"scalar.finite_maximum_unique_modulo_flip","kind":"claim","label":"Finite Gaussian maximizers are unique up to reversal","locator":"Long reasoning record #exact-finite-maximizers","source_id":"authored_long_comparisons_20261024","statement":"For every fixed positive integer n, the pure zero-field SK Hamiltonian with independent standard Gaussian pair couplings has almost surely exactly one maximizing pair {sigma,-sigma}. Configurations not related by global reversal differ in at least one pair product, so their energy difference is a nondegenerate Gaussian; a finite union excludes all such ties. This does not exclude nearly maximizing configurations at other overlaps in the large-n limit.","status":"unverified"},"ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip","relations":[{"derived":true,"family":"provenance","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:1afb0576b7c0110575f81a5670bc03d32bc8144485e6873791d4a8c491b21355","kind":"citation_ids","owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"citation_ids","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/citations/authored_r10_finite_maximizer_uniqueness"},{"derived":true,"family":"provenance","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/evidence/ordinary_r10_proof_route_review_20261026","id":"field:8546198444eafb382a36d0054f48a3fad793ec11676e4c1282482eb853caebd2","kind":"subject_ids","owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/evidence/ordinary_r10_proof_route_review_20261026","semantic_class":"provenance_field_reference","source_field":"subject_ids","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip"},{"derived":true,"family":"provenance","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip","id":"field:a9f898539eb8c7917e8d713086b7b6906bad4d1db159231bb2489cb0eb352e06","kind":"evidence_ids","owner_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_flip","semantic_class":"provenance_field_reference","source_field":"evidence_ids","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/evidence/ordinary_r10_proof_route_review_20261026"},{"derived":true,"family":"provenance","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.finite_maximum_unique_modulo_fli