rivate":false,"protected":false,"short":"continuous_forwardVariance","signature_end_line":45,"used_by":["OAI.ZeroTemperatureSK.Heat.forwardCorrection_continuous","OAI.ZeroTemperatureSK.Heat.forwardGradient_family"],"uses":["OAI.ZeroTemperatureSK.Heat.continuous_forwardTime","OAI.ZeroTemperatureSK.Heat.forwardTime_pos","OAI.ZeroTemperatureSK.Heat.forwardVariance"],"written":"continuous_forwardVariance"},{"dependency_source":"source_text","doc":null,"end_line":52,"kind":"lemma","line":49,"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","name":"OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardTime","namespace":"OAI.ZeroTemperatureSK.Heat","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"hasDerivAt_forwardTime","signature_end_line":49,"used_by":["OAI.ZeroTemperatureSK.Heat.SmoothForward.deriv_ge_inverse","OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardScale","OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardScore"],"uses":["OAI.ZeroTemperatureSK.Heat.forwardTime"],"written":"hasDerivAt_forwardTime"},{"dependency_source":"source_text","doc":null,"end_line":57,"kind":"lemma","line":54,"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","name":"OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardScale","namespace":"OAI.ZeroTemperatureSK.Heat","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"hasDerivAt_forwardScale","signature_end_line":55,"used_by":["OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardCorrection","OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardVariance"],"uses":["OAI.ZeroTemperatureSK.Heat.forwardScale","OAI.ZeroTemperatureSK.Heat.forwardTime","OAI.ZeroTemperatureSK.Heat.forwardTime_pos","OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardTime"],"written":"hasDerivAt_forwardScale"},{"dependency_source":"source_text","doc":null,"end_line":70,"kind":"lemma","line":59,"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","name":"OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardVariance","namespace":"OAI.ZeroTemperatureSK.Heat","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"hasDerivAt_forwardVariance","signature_end_line":60,"used_by":["OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardCorrection"],"uses":["OAI.ZeroTemperatureSK.Heat.forwardScale","OAI.ZeroTemperatureSK.Heat.forwardTime","OAI.ZeroTemperatureSK.Heat.forwardTime_pos","OAI.ZeroTemperatureSK.Heat.forwardVariance","OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardScale"],"written":"hasDerivAt_forwardVariance"},{"dependency_source":"source_text","doc":null,"end_line":73,"kind":"lemma","line":72,"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","name":"OAI.ZeroTemperatureSK.Heat.forwardVariance_pos","namespace":"OAI.ZeroTemperatureSK.Heat","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"forwardVariance_pos","signature_end_line":72,"used_by":["OAI.ZeroTemperatureSK.Heat.hasDerivAt_forwardCorrection"],"uses":["OAI.ZeroTemperatureSK.Heat.forwardTime_pos","OAI.ZeroTemperatureSK.Heat.forwardVariance"],"written":"forwardVariance_pos"},{"dependency_source":"source_text","doc":null,"end_line":81,"kind":"lemma","line":75,"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","name":"OAI.ZeroTemperatureSK.Heat.forwardCorrection_terminal","namespace":"OAI.ZeroTemperatureSK.Heat","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"forwardCorrection_terminal","signature_end_line":76,"used_by":["OAI.ZeroTemperatureSK.Heat.forwardCorrection_shape","OAI.ZeroTemperatureSK.Heat.forwardScore_initial"],"uses":["OAI.ZeroTemperatureSK.Heat.forwardCorrection","OAI.ZeroTemperatureSK.Heat.forwardScale","OAI.ZeroTemperatureSK.Heat.forwardTime","OAI.ZeroTemperatureSK.Heat.forwardVariance","OAI.ZeroTemperatureSK.Heat.varianceLogHeat"],"written":"forwardCorrection_terminal"}],"imports":["Mathlib","OAI.Probability.SKSupport.Backward.Backward"],"module":"OAI.Probability.SKSupport.Parabolic.ForwardGeometry","path":"OAI/Probability/SKSupport/Parabolic/ForwardGeometry.lean","sha256":"71a2359abfefe3db254539860517c0e2579d757665d9af56cb8e22751527eb82","source":"import Mathlib\nimport OAI.Probability.SKSupport.Backward.Backward\n\nnamespace OAI\n\nsection\nopen MeasureTheory ProbabilityTheory Set Filter\nopen scoped ENNReal NNReal Topology ContDiff\nnoncomputable section\nnamespace ZeroTemperatureSK.Heat\n\ndef forwardTime (a t : ℝ) : ℝ := a+max t 0\ndef forwardScale (a t : ℝ) : ℝ := a/forwardTime a t\ndef forwardVariance (a t : ℝ) : ℝ := a*max t 0/forwardTime a t\n\ndef forwardCorrection (a : ℝ) (f : ℝ → ℝ) (t x : ℝ) : ℝ :=\n  (1/2:ℝ)*Real.log (forwardScale a t)+\n    varianceLogHeat 1 (forwardVariance a t) f (forwardScale a t*x)\n\ndef forwardScore (a : ℝ) (f : ℝ → ℝ) (t x : ℝ) : ℝ :=\n  x/forwardTime a t-deriv (forwardCorrection a f t) x\n\nlemma forwardTime_pos {a : ℝ} (ha : 0 < a) (t : ℝ) : 0 < forwardTime a t :=\n  add_pos_of_pos_of_nonneg ha (le_max_right _ _)\n\nlemma forwardScale_pos {a : ℝ} (ha : 0 < a) (t : ℝ) : 0 < forwardScale a t :=\n  div_pos ha (forwardTime_pos ha t)\n\nlemma forwardScale_le_one {a : ℝ} (ha : 0 < a) (t : ℝ) : forwardScale a t ≤ 1 := by\n  apply (div_le_one (forwardTime_pos ha t)).mpr\n  exact le_add_of_nonneg_right (le_max_right _ _)\n\nlemma forwardVariance_nonneg {a : ℝ} (ha : 0 < a) (t : ℝ) : 0 ≤ forwardVariance a t :=\n  div_nonneg (mul_nonneg ha.le (le_max_right _ _)) (forwardTime_pos ha t).le\n\nlemma forwardVariance_le {a : ℝ} (ha : 0 < a) (t : ℝ) : forwardVariance a t ≤ a := by\n  apply (div_le_iff₀ (forwardTime_pos ha t)).mpr\n  try dsimp [forwardTime]\n  nlinarith [sq_nonneg a]\n\nlemma continuous_forwardTime (a : ℝ) : Continuous (forwardTime a) :=\n  continuous_const.add (continuous_id.max continuous_const)\nlemma continuous_forwardScale {a : ℝ} (ha : 0 < a) : Continuous (forwardScale a) :=\n  continuous_const.div (continuous_forwardTime a) (fun t => ne_of_gt (forwardTime_pos ha t))\nlemma continuous_forwardVariance {a : ℝ} (ha : 0 < a) : Continuous (forwardVariance a) :=\n  (continuous_const.mul (continuous_id.max continuous_const)).div (continuous_forwardTime a)\n    (fun t => ne_of_gt (forwardTime_pos ha t))\n\nlemma hasDerivAt_forwardTime {a t : ℝ} (ht : 0 < t) : HasDerivAt (forwardTime a) 1 t := by\n  apply ((hasDerivAt_id t).const_add a).congr_of_eventuallyEq\n  filter_upwards [Ioi_mem_nhds ht] with s hs\n  simp only [forwardTime,max_eq_left (show (0:ℝ) ≤ s from le_of_lt hs),id_eq]\n\nlemma hasDerivAt_forwardScale {a t : ℝ} (ha : 0 < a) (ht : 0 < t) :\n    HasDerivAt (forwardScale a) (-forwardScale a t/forwardTime a t) t := by\n  convert (hasDerivAt_const t a).div (hasDerivAt_forwardTime ht) (ne_of_gt (forwardTime_pos ha t)) using 1 <;>\n    first | rfl | (dsimp [forwardScale]; field_simp; ring)\n\nlemma hasDerivAt_forwardVariance {a t : ℝ} (ha : 0 < a) (ht : 0 < t) :\n    HasDerivAt (forwardVariance a) ((forwardScale a t)^2) t := by\n  have he : forwardVariance a = fun s => a-a*forwardScale a s := by\n    funext s\n    dsimp [forwardVariance,forwardScale]\n    field_simp [ne_of_gt (forwardTime_pos ha s)]\n    dsimp [forwardTime]\n    ring\n  rw [he]\n  convert ((hasDerivAt_forwardScale ha ht).const_mul a).const_sub a using 1\n  dsimp [forwardScale]\n  field_simp\n\nlemma forwardVariance_pos {a t : ℝ} (ha : 0 < a) (ht : 0 < t) : 0 < forwardVariance a t := by\n  exact div_pos (mul_pos ha (lt_of_lt_of_le ht (le_max_left _ _))) (forwardTime_pos ha t)\n\nlemma forwardCorrection_terminal (a : ℝ) (ha : a ≠ 0) (f : ℝ → ℝ) :\n    forwardCorrection a f 0 = f := by\n  have he : varianceLogHeat 1 0 f = f := funext (fun x => by\n    simpa only [backward,sub_self] using backward_terminal 1 0 f x)\n  funext x\n  simp only [forwardCorrection,forwardScale,forwardVariance,forwardTime,max_self,add_zero,\n    mul_zero,zero_div,div_self ha,Real.log_one,mul_zero,zero_add,one_mul,he]\n\nend ZeroTemperatureSK.Heat\n\nend\nend\n\nend OAI\n"}