ec48bcb452c5b8ab7f97/nodes/circuit.positive_mesh","to":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/citations/circuit-r2-26-cite-positive-mesh","kind":"citation_ids","semantic_class":"provenance_field_reference","derived":true,"owner_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/circuit.positive_mesh","source_field":"citation_ids"},{"family":"provenance","id":"field:f9b0c005228dc865b136e34a7ed2d2a9efd90cb5be456b11135206053846ef92","from":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/circuit.positive_mesh","to":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/sources/circuit-r2-26-source-positive","kind":"source_id","semantic_class":"provenance_field_reference","derived":true,"owner_ref":"sha256:c941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97/nodes/circuit.positive_mesh","source_field":"source_id"}],"neighborhood_href":"/api/v1/neighborhood?manifest=79bf16ac8ab3a2adf5741ab97b2e4bd813e1c0a1940efbbdf9e35523f00de8bb&ref=sha256%3Ac941bb8e2efcb2c545fdebbfec6f904193275455192bec48bcb452c5b8ab7f97%2Fnodes%2Fcircuit.positive_mesh"}