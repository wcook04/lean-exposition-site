{"table":"edges","ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22scalar.separate_classical_algorithm%22%2C%22support.full_relative_support%22%2C%22supports%22%5D","record":{"from":"scalar.separate_classical_algorithm","to":"support.full_relative_support","kind":"supports","evidence_ids":["R2-26-SR-044"],"application":{"status":"authored","shared_bindings":{"gamma":"one attained manuscript minimizer gamma_0 in U, kept fixed for full support and the external EAMS theorem"},"premise_bindings":[{"assumption_id":"scalar.paper_minimizer","supplier_id":"scalar.minimizer_attainment","binding_names":["gamma"],"rationale":"Attainment supplies this same gamma_0 in the manuscript class U, with its admissibility and minimality, before applying the conditional full-support theorem."},{"assumption_id":"scalar.paper_admissible","supplier_id":"scalar.minimizer_attainment","binding_names":["gamma"],"rationale":"Attainment supplies this same gamma_0 in the manuscript class U, with its admissibility and minimality, before applying the conditional full-support theorem."}],"remaining_assumption_ids":[],"source_span":{"source_id":"scalar-r2-26-source-algorithm-application","start_line":29,"end_line":34},"rationale":"The algorithm proof applies thm:full-support to a minimizer to obtain the EAMS no-overlap-gap input. Attainment is supplied separately by the manuscript main.tex:94–107 and the existing scalar.minimizer_attainment support. The same attained gamma_0 is used for full support and strict increase. This authored application records the full-support input only, not a proof or formalization of the external algorithm theorem."}},"usage":{"record_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22scalar.separate_classical_algorithm%22%2C%22support.full_relative_support%22%2C%22supports%22%5D","paper_focus":[],"paper_memberships":[{"stage":"long","subgraph_ref":"sha256:135459bb2961c95bd09cfce135666cd5a51fd