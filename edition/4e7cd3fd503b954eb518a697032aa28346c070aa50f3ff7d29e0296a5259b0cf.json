om derivatives of the contact function, with a separate right-hand expansion at zero. The origin argument retains contact at zero when zero belongs to the support and the zero-field identity q(0)=0."}],"to":"sha256:0cab99e62e04475d45ef7ab47579feee2be323ae8b9c4108d1e26adbd1ba36a2/papers/short.md/sha256:70909c03af03ed97dc42b71d01507ad744339ac2af9a884a4b889c882ece1c4a/papers/short.json/passages/contact"},{"annotation_basis":"shared_claim_ids","derived":true,"from":"sha256:c17d1e4e497443c153dbfaed9967804be060f37981ee446a2f3daf79a50f2f7a/papers/expository.md/sha256:3c748f53bb2f3e44dcb0d6e814dfdec32f507d6f2c7aca36d581cbe758b05a36/papers/expository.json/passages/contact-and-gap","id":"shared-claims:04e2748ea9a1ad1888b7ddfaea7c9bd5f417dbf2bc3f9cb850aa9cdf3b8cd4dd","kind":"shared_claim","selection_relation":"outgoing","shared_claim_refs":["sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/support.positive_curvature"],"source_field":"passages.claim_ids","source_ref":"sha256:3c748f53bb2f3e44dcb0d6e814dfdec32f507d6f2c7aca36d581cbe758b05a36/papers/expository.json","source_treatments":[],"target_ref":"sha256:70909c03af03ed97dc42b71d01507ad744339ac2af9a884a4b889c882ece1c4a/papers/short.json","target_treatments":[],"to":"sha256:0cab99e62e04475d45ef7ab47579feee2be323ae8b9c4108d1e26adbd1ba36a2/papers/short.md/sha256:70909c03af03ed97dc42b71d01507ad744339ac2af9a884a4b889c882ece1c4a/papers/short.json/passages/curvature"},{"annotation_basis":"shared_claim_ids","derived":true,"from":"sha256:c17d1e4e497443c153dbfaed9967804be060f37981ee446a2f3daf79a50f2f7a/papers/expository.md/sha256:3c748f53bb2f3e44dcb0d6e814dfdec32f507d6f2c7aca36d581cbe758b05a36/papers/expository.json/passages/contact-and-gap","id":"shared-claims:7824b4b9ecc63886d38bb0d2a1a5e5982f7c390445b775294bf8c588ddf63504","kind":"shared_claim","selection_relation":"outgoing","shared_claim_refs":["sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/support.no_bounded_gap","sha256: