{"table":"nodes","ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.formal_parisi_clause","record":{"id":"scalar.formal_parisi_clause","kind":"claim","label":"Parisi identity branch without a supplied diffusion","status":"unverified","source_id":"scalar-r2-26-source-formal-targets","locator":"GroundState/MainConclusions.lean:21–27; ground_state_parisi_target","statement":"For every W:BrownianSpace and gamma:OrderParameter, IsMinimizer W gamma implies groundStateValue=parisi W gamma. No X or IsDiffusion hypothesis is supplied by the caller; the proof uses diffusionProcess_isDiffusion W gamma.","assumption_ids":["assumptions.value_minimizer"],"evidence_ids":[],"citation_ids":["scalar-r2-26-cite-formal-parisi-clause"],"boundary":"The exact SKValue model uses a coefficient on all reals with its stated interval fields, BrownianSpace and its natural filtration. Source inspected; no kernel replay, Comparator acceptance or elaborated dependency extraction is recorded. This branch must be selectable without importing an external diffusion premise."},"usage":{"record_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.formal_parisi_clause","paper_focus":[],"paper_memberships":[{"stage":"long","subgraph_ref":"sha256:135459bb2961c95bd09cfce135666cd5a51fd11bb2c943829fdd7b81efdfef5d/papers/long.json/support/0.3.1/2f85413164f06365ea0d825befee447650da71d54080d5dd65e78a708891c560","roles":["mapped_claim"]},{"stage":"short","subgraph_ref":"sha256:cfbe950801fd334d8fd957243fa3b1f716ef609148c5f2ff97d44f9a6443d82c/papers/short.json/support/0.3.1/77f0cf29ab577b42d8caa5b2831ebfb1ca170d4b13c1ef6897cadc8e93c2a834","roles":["recorded_prerequisite"]},{"stage":"expository","subgraph_ref":"sha256:479155de953858e60f1454491ccda2215d88a4c2780e686cdfb8422481c62d9c/papers/expository.json/support/0.3.1/9dd5536bc567fc55efaa864733bf89747cea0268a8a3865dec51ddd8e2a235dd","roles":["recorded_prerequisite"]}],"direct_passages":[{