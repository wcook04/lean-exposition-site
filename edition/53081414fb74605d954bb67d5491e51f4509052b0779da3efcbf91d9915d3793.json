nditionally modulo harmless root-seed phases; off-helper insertions converge.","status":"unverified"},"ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.helper_contraction","relations":[{"derived":false,"family":"arguments","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.helper_contraction","id":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/edges/%5B%22circuit.helper_contraction%22%2C%22circuit.additive_responses%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/edges/%5B%22circuit.helper_contraction%22%2C%22circuit.additive_responses%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.additive_responses"},{"derived":false,"family":"arguments","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.helper_contraction","id":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/edges/%5B%22circuit.helper_contraction%22%2C%22circuit.gate_calculus%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/edges/%5B%22circuit.helper_contraction%22%2C%22circuit.gate_calculus%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.gate_calculus"},{"derived":false,"family":"arguments","from":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/nodes/circuit.helper_contraction","id":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc1686433b4a62c89a6f0f0/edges/%5B%22circuit.helper_contraction%22%2C%22circuit.orthogonal_quadratics%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:05cd25e48622c61863e237a23bb6df11291711ec1cc