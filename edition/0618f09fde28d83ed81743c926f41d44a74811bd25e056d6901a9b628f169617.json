d65acbde651f5ad06a20&node=support.near_ground_pairs&relation=prerequisites","prerequisites":"/api/v1/graph?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&view=arguments&node=support.near_ground_pairs&assumptions=true"},"neighborhood_href":"/api/v1/neighborhood?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&ref=sha256%3A9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5%2Fnodes%2Fsupport.near_ground_pairs","record":{"assumption_ids":[],"boundary":"Ordinary consequence of the imported landscape theorem, full support and attained Parisi formula. Add a common independent N(0,1/2) offset to match covariance; remove it using its Gaussian tail. Each target overlap is fixed before taking size. No typical-pair law, continuum-simultaneous event, efficient construction, Lean extraction or formal proof acceptance is asserted.","citation_ids":["acz2020_near_ground_pairs"],"evidence_ids":["near_ground_pair_warrants_20261024"],"id":"support.near_ground_pairs","kind":"claim","label":"Near-ground configurations at a prescribed overlap","locator":"Proposition 1, equation (5), p.5; proof pp.15–16; pure-SK specialization reconstructed in the long record, Near-ground configurations at a prescribed overlap (#near-ground-overlaps).","source_id":"acz2020_infinite_support","statement":"For pure zero-field Gaussian SK H_n=n^(-1/2) sum_{i<j} J_ij sigma_i sigma_j, every fixed r in [0,1) and epsilon,eta>0 admit K=K(r,epsilon,eta)>0 independent of n, such that with disorder probability at least 1-K exp(-n/K) there exist sigma,tau with |R(sigma,tau)-r|<epsilon and both H_n(sigma)/n,H_n(tau)/n >= P_*-eta, for all n>=1.","status":"unverified"},"ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.near_ground_pairs","relations":[{"derived":false,"family":"arguments","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.near_ground_pairs","id":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22scalar.minimizer_attainment%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22scalar.minimizer_attainment%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.minimizer_attainment"},{"derived":false,"family":"arguments","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.near_ground_pairs","id":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22scalar.parisi_formula%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22scalar.parisi_formula%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/scalar.parisi_formula"},{"application":{"premise_bindings":[{"assumption_id":"scalar.paper_minimizer","binding_names":["gamma"],"rationale":"Attainment supplies gamma_0 minimizing the same manuscript Parisi functional. Full support is applied to this gamma_0; the landscape theorem then uses the Stieltjes support of that same minimizer.","supplier_id":"scalar.minimizer_attainment"},{"assumption_id":"scalar.paper_admissible","binding_names":["gamma"],"rationale":"The attained gamma_0 belongs to the same class U, so its admissibility accompanies its minimality. Pure zero-field SK and xi(t)=t^2/2 remain the fixed model; the common Gaussian covariance adjustment is retained in the landscape argument.","supplier_id":"scalar.minimizer_attainment"}],"rationale":"The long record applies ACZ Proposition 1 to the full-support minimizer and identifies its value using the attained Parisi formula. Attainment is supplied by the separately sourced scalar.minimizer_attainment node (and explained in the long record at #minimizer-attainment); it is not an extra caller premise of the landscape consequence. This records the ordinary same-witness application only. The external landscape theorem and the covariance correction remain necessary inputs; no cross-model Lean transport, checked substitution or formal acceptance is asserted.","remaining_assumption_ids":[],"shared_bindings":{"gamma":"one attained minimizer gamma_0 in the manuscript pure zero-field SK class U, used for full support and the support-point premise of the ACZ landscape theorem"},"source_span":{"end_line":3761,"source_id":"authored_long_comparisons_20261024","start_line":3686},"status":"authored"},"application_metadata_scope":"remaining_assumption_ids is authored historical metadata, not an effective obligation audit; path-local suppression may be lifted for retained formal dependencies.","derived":false,"family":"arguments","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.near_ground_pairs","id":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22support.full_relative_support%22%2C%22supports%22%5D","kind":"supports","record_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/edges/%5B%22support.near_ground_pairs%22%2C%22support.full_relative_support%22%2C%22supports%22%5D","semantic_class":"curated_argument_support","to":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.full_relative_support"},{"derived":true,"family":"provenance","from":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/evidence/near_ground_pair_warrants_20261024","id":"field:0c063ae32ae27009fe4d7d122760ac58357722c328f25febebafa0f51801891c","kind":"subject_ids","owner_ref":"sh