/support.no_initial_gap","sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.positive_curvature","sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.terminal_chord_barrier","sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.zero_curvature"],"evidence_class":"source_argument","treatments":[{"claim_id":"support.positive_curvature","kinds":["statement","application"],"rationale":"States the quantitative curvature estimate for any admissible positive plateau and applies it together with minimiser contact to exclude a bounded gap. The estimate is an imported input here; its nonminimiser scope does not supply contact.","claim_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.positive_curvature"},{"claim_id":"support.no_bounded_gap","kinds":["derivation"],"rationale":"Derives the bounded-gap contradiction by integrating the endpoint-chord bound for q prime. Contact and the imported curvature estimate have separate roles; the initial and terminal cases are treated separately in the same passage.","claim_ref":"sha256:9a43c3eddb32c8ae6201629ef2e4df2d94167dc286a45dd429a8dff192df88b5/nodes/support.no_bounded_gap"}],"query_href":"/api/v1/papers/query?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&paper=short&passage=gap-proof&representation=matches","reading_href":"/api/v1/papers/reading?manifest=41f03ec0a8b1d30d68310120008da72a73f8c3f4cc88d65acbde651f5ad06a20&paper=short&passage=gap-proof"},{"ref":"sha256:267b41919f95376c728c2f90f5c80e4bf7aa13ca3418d4931ff608c908902e54/papers/short.md/sha256:cfbe950801fd334d8fd957243fa3b1f716ef609148c5f2ff97d44f9a6443d82c/papers/short.json/passages/curvature","stage":"short","anchor":"curvature","content_span":{"start_byte":16018,"end_byte":27859,"start_line":331,"end_line":568},"section_ref":"sha256:267b41919f95376c728c2f90f5c80e4bf7aa13ca3418d4931ff608c908902e54/papers/s