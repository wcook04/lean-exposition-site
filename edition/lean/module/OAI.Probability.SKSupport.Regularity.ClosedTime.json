e,"private":false,"protected":false,"short":"normalizedIncrement","signature_end_line":53,"used_by":["OAI.ZeroTemperatureSK.gaussianCoeffA"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.GaussianSample","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.curvature","OAI.ZeroTemperatureSK.eulerNormalizer","OAI.ZeroTemperatureSK.eulerState","OAI.ZeroTemperatureSK.gaussianCoordinate","OAI.ZeroTemperatureSK.meshTime"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.OrderParameter":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.curvature":"OAI.Probability.SKSupport.Model"},"written":"normalizedIncrement"},{"dependency_source":"source_text","doc":null,"end_line":61,"kind":"def","line":58,"module":"OAI.Probability.SKSupport.Regularity.ClosedTime","name":"OAI.ZeroTemperatureSK.randomizedSign","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"randomizedSign","signature_end_line":59,"used_by":["OAI.ZeroTemperatureSK.gaussianCoeffA","OAI.ZeroTemperatureSK.gaussianCoeffB"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.GaussianSample","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.eulerState","OAI.ZeroTemperatureSK.gaussianCoordinate","OAI.ZeroTemperatureSK.gradient"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.OrderParameter":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.gradient":"OAI.Probability.SKSupport.Model"},"written":"randomizedSign"},{"dependency_source":"source_text","doc":null,"end_line":66,"kind":"def","line":63,"module":"OAI.Probability.SKSupport.Regularity.ClosedTime","name":"OAI.ZeroTemperatureSK.gaussianCoeffA","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"gaussianCoeffA","signature_end_line":64,"used_by":["OAI.ZeroTemperatureSK.gaussianValueSum"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.gaussianLaw","OAI.ZeroTemperatureSK.normalizedIncrement","OAI.ZeroTemperatureSK.randomizedSign"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.OrderParameter":"OAI.Probability.SKSupport.Model"},"written":"gaussianCoeffA"},{"dependency_source":"source_text","doc":null,"end_line":70,"kind":"def","line":68,"module":"OAI.Probability.SKSupport.Regularity.ClosedTime","name":"OAI.ZeroTemperatureSK.gaussianCoeffB","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"gaussianCoeffB","signature_end_line":69,"used_by":["OAI.ZeroTemperatureSK.gaussianValueSum"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.gaussianCoordinate","OAI.ZeroTemperatureSK.gaussianLaw","OAI.ZeroTemperatureSK.randomizedSign"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.OrderParameter":"OAI.Probability.SKSupport.Model"},"written":"gaussianCoeffB"},{"dependency_source":"source_text","doc":null,"end_line":74,"kind":"def","line":72,"module":"OAI.Probability.SKSupport.Regularity.ClosedTime","name":"OAI.ZeroTemperatureSK.gaussianValueSum","namespace":"OAI.ZeroTemperatureSK","noncomputable":false,"noncomputable_section":true,"private":false,"protected":false,"short":"gaussianValueSum","signature_end_line":73,"used_by":["OAI.ZeroTemperatureSK.GaussianConclusion"],"uses":["OAI.ZeroTemperatureSK.BrownianSystem","OAI.ZeroTemperatureSK.OrderParameter","OAI.ZeroTemperatureSK.gaussianCoeffA","OAI.ZeroTemperatureSK.gaussianCoeffB"],"uses_modules":{"OAI.ZeroTemperatureSK.BrownianSystem":"OAI.Probability.SKSupport.Model","OAI.ZeroTemperatureSK.OrderParameter":"OAI.Probability.SKSupport.Model"},"written":"gaussianValueSum"}],"imports":["Mathlib","OAI.Probability.SKSupport.Model"],"module":"OAI.Probability.SKSupport.Regularity.ClosedTime","path":"OAI/Probability/SKSupport/Regularity/ClosedTime.lean","sha256":"ad236088df2c454ffd75db2ce76def08e5707d4602a3833a18ee9d18c747d570","source":"import Mathlib\nimport OAI.Probability.SKSupport.Model\n\nnamespace OAI\n\nsection\nopen MeasureTheory ProbabilityTheory Set Filter\nopen scoped ENNReal NNReal Topology\nnoncomputable section\nnamespace ZeroTemperatureSK\n\nabbrev ClosedTime := Set.Icc (0 : ℝ) 1\n\nvariable {Ω : Type*} [MeasurableSpace Ω]\n\ndef closedFiltration (W : BrownianSystem Ω) : Filtration ClosedTime ‹MeasurableSpace Ω› where\n  seq t := Filtration.natural W.B (fun s => (W.measurable s).stronglyMeasurable) (Real.toNNReal t)\n  mono' := fun _ _ h => (Filtration.natural W.B\n    (fun s => (W.measurable s).stronglyMeasurable)).mono (Real.toNNReal_mono h)\n  le' t := (Filtration.natural W.B (fun s => (W.measurable s).stronglyMeasurable)).le (Real.toNNReal t)\n\ndef terminalGradient (W : BrownianSystem Ω) (γ : OrderParameter)\n    (X : ℝ≥0 → Ω → ℝ) (U₁ : Ω → ℝ) (t : ClosedTime) : Ω → ℝ :=\n  if (t : ℝ) < 1 then fun ω => gradient W γ t (X (Real.toNNReal t) ω) else U₁\n\nabbrev GaussianSample (N : ℕ) := Fin (N+1) → ℝ\n\ndef gaussianLaw (N : ℕ) : Measure (GaussianSample N) :=\n  Measure.pi (fun _ => gaussianReal 0 1)\n\ndef gaussianCoordinate (N i : ℕ) (z : GaussianSample N) : ℝ :=\n  if hi : i < N+1 then z ⟨i, hi⟩ else 0\n\ndef meshStep (T : ℝ) (N : ℕ) : ℝ := T / N\n\ndef meshTime (T : ℝ) (N j : ℕ) : ℝ := j * meshStep T N\n\ndef eulerState (W : BrownianSystem Ω) (γ : OrderParameter) (T : ℝ) (N : ℕ) :\n    ℕ → GaussianSample N → ℝ\n  | 0, _ => 0\n  | j+1, z => eulerState W γ T N j z + Real.sqrt (meshStep T N) * gaussianCoordinate N j z +\n      meshStep T N * extend γ.val (meshTime T N j) *\n        gradient W γ (meshTime T N j) (eulerState W γ T N j z)\n\ndef eulerCurvatureMoment (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N j : ℕ) : ℝ :=\n  ∫ z, (curvature W γ (meshTime T N (j-1)) (eulerState W γ T N (j-1) z))^2 ∂gaussianLaw N\n\ndef eulerNormalizer (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N j : ℕ) : ℝ := (Real.sqrt (eulerCurvatureMoment W γ T N j))⁻¹\n\ndef normalizedIncrement (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N j : ℕ) (z : GaussianSample N) : ℝ :=\n  eulerNormalizer W γ T N j *\n    curvature W γ (meshTime T N (j-1)) (eulerState W γ T N (j-1) z) *\n      gaussianCoordinate N (j-1) z\n\ndef randomizedSign (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N : ℕ) (z : GaussianSample N) : ℝ :=\n  (SignType.sign (gradient W γ T (eulerState W γ T N N z) +\n    2 * cdf (gaussianReal 0 1) (gaussianCoordinate N N z) - 1) : ℝ)\n\ndef gaussianCoeffA (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N j : ℕ) : ℝ :=\n  if j = 0 then 0 else\n    ∫ z, randomizedSign W γ T N z * normalizedIncrement W γ T N j z ∂gaussianLaw N\n\ndef gaussianCoeffB (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N i : ℕ) : ℝ :=\n  ∫ z, randomizedSign W γ T N z * gaussianCoordinate N (i-1) z ∂gaussianLaw N\n\ndef gaussianValueSum (W : BrownianSystem Ω) (γ : OrderParameter)\n    (T : ℝ) (N : ℕ) : ℝ :=\n  ∑ j ∈ Finset.range (N+1), gaussianCoeffA W γ T N j * gaussianCoeffB W γ T N (j+1)\n\nend ZeroTemperatureSK\n\nend\nend\n\nend OAI\n"}